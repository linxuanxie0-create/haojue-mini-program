.page { min-height: 100vh; padding: 28rpx 38rpx 190rpx; }
.topbar { display:flex; align-items:center; margin-bottom:58rpx; }
.brand-mark { width:66rpx; height:66rpx; border-radius:50%; background:#d7fb35; display:flex; align-items:center; justify-content:center; font-size:25rpx; font-weight:700; }
.brand-copy { margin-left:15rpx; }
.brand-name,.brand-note,.page-title,.page-subtitle,.step-label,.step-name,.question-title,.question-hint,.option-label,.selection-note,.summary-title,.summary-subtitle,.summary-answer,.summary-detail,.privacy-note { display:block; }
.brand-name { font-size:22rpx; font-weight:600; }.brand-note { margin-top:4rpx; color:#858681; font-size:17rpx; }
.top-link { margin-left:auto; padding:18rpx 24rpx; border-radius:34rpx; background:#fff; color:#575852; font-size:18rpx; }
.intro { margin-bottom:47rpx; }.page-title { font-size:58rpx; line-height:1.2; font-weight:650; letter-spacing:-1rpx; }.page-subtitle { margin-top:12rpx; font-size:23rpx; line-height:1.5; color:#74756f; }
.progress-head { display:flex; align-items:center; gap:14rpx; margin-bottom:15rpx; }.step-label { color:#171717; font-size:20rpx; font-weight:650; font-variant-numeric:tabular-nums; }.step-name { color:#858681; font-size:19rpx; }
.progress-track { display:flex; gap:8rpx; }.progress-segment { flex:1; height:7rpx; border-radius:8rpx; background:#dedfda; }.progress-segment.filled { background:#d7fb35; }
.question-block { margin:43rpx 0 25rpx; }.question-title { max-width:640rpx; font-size:35rpx; line-height:1.4; font-weight:620; letter-spacing:-.4rpx; }.question-hint { margin-top:10rpx; font-size:20rpx; line-height:1.5; color:#73746e; }
.option-grid { display:flex; flex-wrap:wrap; gap:15rpx; }.option { width:calc(50% - 8rpx); min-height:99rpx; display:flex; align-items:center; justify-content:space-between; padding:0 24rpx; border-radius:25rpx; background:#fff; transition:background-color .16s ease; }.option-selected { background:#d7fb35; }.option-label { max-width:calc(100% - 42rpx); font-size:21rpx; line-height:1.4; font-weight:520; }
.option-check { flex-shrink:0; width:30rpx; height:30rpx; border:2rpx solid #c7c8c1; border-radius:50%; display:flex; align-items:center; justify-content:center; }.option-selected .option-check { border-color:#191a17; }.check-dot { width:14rpx; height:14rpx; border-radius:50%; background:#191a17; }
.selection-note { margin-top:18rpx; font-size:18rpx; color:#858681; }
.summary-content { margin-top:4rpx; }.summary-heading { margin-bottom:26rpx; }.summary-title { font-size:35rpx; font-weight:620; }.summary-subtitle { margin-top:9rpx; font-size:20rpx; color:#74756f; }.summary-list { padding:0 26rpx; background:#fff; border-radius:28rpx; }.summary-row { padding:22rpx 0; border-bottom:1rpx solid #eeefeb; }.summary-row:last-child { border-bottom:0; }.summary-label { display:flex; align-items:center; justify-content:space-between; color:#858681; font-size:18rpx; }.summary-index { font-size:15rpx; color:#a0a19b; }.summary-answer { margin-top:9rpx; font-size:21rpx; font-weight:560; line-height:1.45; }.summary-detail { margin-top:5rpx; font-size:16rpx; color:#858681; }
.result-content { margin-top:4rpx; }.result-heading { margin-bottom:26rpx; }.result-title { font-size:35rpx; font-weight:620; }.result-subtitle { margin-top:9rpx; font-size:20rpx; color:#74756f; }.result-placeholder { padding:64rpx 34rpx; background:#fff; border-radius:28rpx; display:flex; flex-direction:column; gap:14rpx; }.result-empty { font-size:24rpx; font-weight:620; }.result-empty-note { font-size:18rpx; line-height:1.6; color:#858681; }
.bottom-area { position:fixed; left:0; right:0; bottom:0; z-index:5; padding:22rpx 38rpx calc(20rpx + env(safe-area-inset-bottom)); background:#f4f4f2; }.bottom-actions { display:flex; gap:14rpx; }.back-button,.next-button { min-height:92rpx; display:flex; align-items:center; justify-content:center; border-radius:48rpx; font-size:21rpx; font-weight:620; }.back-button { width:30%; background:#fff; }.next-button { flex:1; gap:13rpx; background:#171717; color:#fff; }.button-arrow { font-size:31rpx; font-weight:400; line-height:1; }.button-disabled { background:#e2e3de; color:#6a6b64; }.privacy-note { margin-top:13rpx; text-align:center; font-size:16rpx; color:#888983; }

/* Filled result data uses the existing summary-card styles. */
.result-title,.result-subtitle { display:block; }
.result-content .summary-list { margin-bottom:16rpx; }
