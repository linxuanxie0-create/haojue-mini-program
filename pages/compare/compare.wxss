.compare-page { padding:26rpx 32rpx 150rpx; }
.page-heading { margin:8rpx 4rpx 22rpx; }.heading-title { display:block;font-size:34rpx;line-height:1.35;font-weight:650;letter-spacing:-.4rpx; }.heading-note { display:block;margin-top:6rpx;font-size:17rpx;color:#73746e; }
.model-pair { display:flex;gap:12rpx; }.model-card { min-width:0;flex:1;overflow:hidden;border-radius:25rpx;background:#fff; }.image-stage { height:244rpx;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fff; }.image-glow { position:absolute;width:290rpx;height:118rpx;bottom:19rpx;border-radius:50%;background:#f2f3ed; }.vehicle-image { width:100%;height:100%;position:relative;z-index:1; }.image-caption { position:absolute;right:12rpx;bottom:10rpx;z-index:2;font-size:14rpx;color:#777872; }.model-info { min-height:83rpx;padding:12rpx 13rpx;display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #f0f0ed; }.model-info view { flex:1;min-width:0; }.model-name { display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:19rpx;font-weight:650; }.model-meta { display:block;margin-top:4rpx;font-size:15rpx;color:#6a6b66; }.model-change { flex-shrink:0;margin-left:5rpx;padding:10rpx 14rpx;border-radius:20rpx;background:#f1f2ee;font-size:15rpx; }
.placeholder-stage { flex-direction:column;gap:12rpx;background:#eceee9; }.placeholder-mark { width:57rpx;height:57rpx;border:2rpx dashed #adb0a8;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:300;color:#7a7d75; }.placeholder-copy { font-size:16rpx;color:#767871; }
.section-head { display:flex;justify-content:space-between;align-items:center;margin:29rpx 4rpx 13rpx; }.section-title { display:block;font-size:25rpx;font-weight:650; }.section-subtitle { display:block;margin-top:4rpx;font-size:15rpx;color:#777872; }.section-mark { font-size:14rpx;color:#858681;font-variant-numeric:tabular-nums; }
.scene-tabs { display:flex;gap:9rpx; }.scene-tab { flex:1;min-width:0;height:88rpx;border-radius:32rpx;display:flex;align-items:center;justify-content:center;background:#fff;color:#494a45;font-size:18rpx; }.scene-active { background:#d7fb35;color:#171717;font-weight:650; }
.scene-card { min-height:620rpx;margin-top:14rpx;padding:28rpx 24rpx 24rpx;background:#fff;border-radius:26rpx;display:flex;flex-direction:column; }.scene-title-row { display:flex;justify-content:space-between;align-items:flex-start;gap:18rpx; }.scene-title { display:block;font-size:28rpx;line-height:1.3;font-weight:650; }.scene-description { display:block;margin-top:9rpx;font-size:18rpx;line-height:1.6;color:#777872; }.scene-number { width:54rpx;height:54rpx;flex-shrink:0;border-radius:50%;background:#171717;color:#fff;display:flex;align-items:center;justify-content:center;font-size:16rpx; }.scene-focus { margin-top:30rpx;padding:20rpx;background:#f4f5f0;border-radius:18rpx; }.focus-label { display:block;font-size:15rpx;color:#75766f;margin-bottom:8rpx; }.focus-copy { display:block;font-size:20rpx;line-height:1.5;font-weight:600; }.advantage-label { display:block;margin:30rpx 0 12rpx;font-size:15rpx;color:#777872; }.advantage-pair { flex:1;display:flex;flex-direction:column;gap:14rpx; }.advantage-card { min-height:118rpx;padding:22rpx 20rpx;border-radius:18rpx;background:#f7f7f5;display:flex;flex-direction:column;justify-content:center; }.advantage-model { display:block;font-size:19rpx;line-height:1.35;font-weight:650; }.advantage-copy { display:block;margin-top:8rpx;font-size:17rpx;line-height:1.55;color:#858681; }
.page-note { margin:17rpx 4rpx;font-size:14rpx;line-height:1.45;color:#73746e; }.bottom-actions { position:fixed;left:28rpx;right:28rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));z-index:5;height:92rpx;padding:8rpx;border-radius:50rpx;background:#fff;box-shadow:0 8rpx 36rpx rgba(0,0,0,.08); }.next-button { height:100%;border-radius:42rpx;background:#171717;color:#fff;display:flex;align-items:center;justify-content:center;gap:12rpx;font-size:19rpx;font-weight:650; }.next-button.button-disabled { background:#dedfda;color:#6a6b64; }.next-button text { font-size:30rpx;line-height:1;font-weight:400; }

.picker-mask { position:fixed;left:0;right:0;top:0;bottom:0;z-index:20;background:rgba(20,20,20,.42);display:flex;align-items:flex-end; }
.picker-panel { width:100%;max-height:78vh;background:#fff;border-radius:28rpx 28rpx 0 0;display:flex;flex-direction:column;overflow:hidden; }
.picker-head { height:88rpx;padding:0 30rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f0ed;font-size:24rpx;font-weight:650; }
.picker-close { width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;color:#8b8c86;font-size:40rpx;line-height:1; }
.picker-list { height:62vh;box-sizing:border-box;padding:10rpx 20rpx 40rpx; }
.picker-item { min-height:112rpx;padding:12rpx 14rpx;border-radius:18rpx;display:flex;align-items:center;gap:14rpx; }
.picker-item-active { background:#eef3d8; }
.picker-thumb { width:130rpx;height:92rpx;flex-shrink:0; }
.picker-copy { min-width:0;flex:1;display:flex;flex-direction:column; }
.picker-name { display:block;font-size:21rpx;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.picker-cat { display:block;margin-top:6rpx;font-size:16rpx;color:#6a6b66; }
.picker-check { flex-shrink:0;width:34rpx;height:34rpx;margin-left:4rpx;border-radius:50%;background:#171717;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20rpx; }
.picker-detail { flex-shrink:0;margin-left:4rpx;padding:13rpx 16rpx;border-radius:18rpx;background:#f1f2ee;color:#4b4c46;font-size:16rpx; }
