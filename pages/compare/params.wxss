.parameter-page { height:100vh;max-height:100vh;overflow:hidden;box-sizing:border-box;display:flex;flex-direction:column;padding:12rpx 28rpx calc(12rpx + env(safe-area-inset-bottom)); }
.parameter-heading { flex-shrink:0;display:flex;align-items:flex-end;justify-content:space-between;margin:0 4rpx 13rpx; }.parameter-title { display:block;font-size:29rpx;line-height:1.25;font-weight:650; }.parameter-subtitle { display:block;margin-top:4rpx;font-size:17rpx;color:#73746e; }.page-count { padding-bottom:3rpx;font-size:14rpx;color:#858681;font-variant-numeric:tabular-nums; }
.model-headings { flex-shrink:0;display:flex;gap:9rpx;margin-bottom:10rpx; }.model-heading { min-width:0;flex:1;height:64rpx;padding:0 12rpx;border-radius:18rpx;background:#fff;display:flex;align-items:center; }.model-dot { width:34rpx;height:34rpx;flex-shrink:0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14rpx;font-weight:700; }.dot-a { background:#d7fb35; }.dot-b { background:#171717;color:#fff; }.model-heading-copy { min-width:0;margin-left:9rpx; }.model-heading-name { display:block;max-width:200rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:17rpx;font-weight:650; }.model-heading-meta { display:block;margin-top:2rpx;font-size:14rpx;color:#6a6b66; }
.table-head { flex-shrink:0;height:52rpx;padding:0 12rpx;background:#eceee9;border-radius:15rpx 15rpx 0 0;display:flex;align-items:center; }.parameter-column { flex:1;min-width:0; }.table-label { display:block;font-size:16rpx;font-weight:650; }.table-sublabel { display:none; }.value-column { width:166rpx;flex-shrink:0;text-align:center;font-size:14rpx;font-weight:650; }.parameter-list { flex:1;min-height:0;overflow:hidden;padding:0 12rpx;background:#fff;border-radius:0 0 15rpx 15rpx;box-sizing:border-box; }.parameter-row { min-height:96rpx;padding:12rpx 0;display:flex;align-items:center;border-bottom:1rpx solid #eeefeb; }.parameter-row:last-child { border-bottom:0; }.parameter-copy { flex:1;min-width:0;padding:2rpx 0; }.parameter-name { display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:18rpx;line-height:1.15;font-weight:620; }.parameter-translation { display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;margin-top:3rpx;font-size:16rpx;line-height:1.35;color:#55564f; }.parameter-value { width:166rpx;flex-shrink:0;text-align:center;font-size:17rpx;line-height:1.45;white-space:normal;overflow-wrap:anywhere;word-break:break-all;color:#858681; }
.parameter-footer { flex-shrink:0;padding-top:10rpx; }.data-note { display:block;text-align:center;font-size:15rpx;line-height:1.4;color:#55564f; }.back-to-scenes { height:67rpx;margin-top:9rpx;border-radius:35rpx;background:#171717;color:#fff;display:flex;align-items:center;justify-content:center;font-size:17rpx;font-weight:620; }
