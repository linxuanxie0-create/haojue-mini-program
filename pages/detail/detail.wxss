.detail-page { padding:18rpx 34rpx 150rpx; }.demo-badge { position:absolute;top:20rpx;right:24rpx;z-index:3;padding:8rpx 14rpx;border-radius:14rpx;background:#f4f5ef;color:#8b8c86;font-size:14rpx; }
.topline { height:82rpx;display:flex;align-items:center;justify-content:space-between; }.circle-button { width:64rpx;height:64rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:44rpx;font-weight:300; }.top-title { font-size:24rpx;font-weight:600; }.more { font-size:32rpx;letter-spacing:2rpx; }
.hero-card { position:relative;border-radius:44rpx;background:#fff;padding:30rpx 32rpx 22rpx;overflow:hidden; }.hero-copy { position:relative;z-index:2; }.eyebrow { display:block;font-size:16rpx;color:#93938e;letter-spacing:2rpx;margin-bottom:9rpx; }.model-title { display:block;font-size:54rpx;font-weight:600;letter-spacing:-2rpx; }.model-sub { display:block;font-size:21rpx;color:#83837f;margin-top:4rpx; }
.bike-stage { position:relative;height:400rpx;margin:0 -10rpx;display:flex;align-items:center;justify-content:center; }.stage-glow { position:absolute;width:510rpx;height:250rpx;border-radius:50%;background:#f2f3ed;bottom:22rpx; }.bike-image { position:relative;z-index:1;width:100%;height:100%; }.stage-label { position:absolute;bottom:22rpx;right:16rpx;color:#b2b3ad;font-size:15rpx;letter-spacing:3rpx; }.swatches { display:flex;align-items:center;gap:12rpx;font-size:16rpx;color:#969690; }.swatch { width:29rpx;height:29rpx;border-radius:50%;border:4rpx solid #fff;box-shadow:0 0 0 1rpx #deded9; }.swatch.silver { background:#d6d8d5; }.swatch.black { background:#202323; }.swatch.olive { background:#8b9386; }.swatches text { margin-left:5rpx; }
.tabs { display:flex;gap:35rpx;margin:30rpx 8rpx 24rpx;border-bottom:1rpx solid #e6e6e1; }.tab { padding:0 0 17rpx;font-size:21rpx;color:#92928e; }.tab.current { color:#191919;font-weight:600;border-bottom:5rpx solid #d7fb35; }
.intro { display:flex;justify-content:space-between;align-items:flex-end;margin:0 8rpx 20rpx; }.section-title { display:block;font-size:29rpx;font-weight:600; }.intro-copy { width:45%;font-size:16rpx;color:#8d8d88;line-height:1.5;text-align:right; }
.metrics { display:flex;gap:14rpx; }.metric { flex:1;border-radius:28rpx;padding:20rpx 22rpx 18rpx;min-height:148rpx; }.metric.lime { background:#d7fb35; }.metric.dark { background:#171717;color:#fff; }.metric-top { display:flex;justify-content:space-between;align-items:center;font-size:17rpx;color:rgba(0,0,0,.62); }.dark .metric-top { color:#bcbcbc; }.metric-arrow { width:38rpx;height:38rpx;border-radius:50%;border:1rpx solid currentColor;text-align:center;line-height:34rpx;font-size:23rpx; }.metric-value { display:block;font-size:39rpx;font-weight:500;margin-top:9rpx; }.metric-foot { display:block;font-size:15rpx;opacity:.65;margin-top:0; }
.feature-list { background:#fff;border-radius:28rpx;margin-top:20rpx;padding:0 22rpx; }.feature-row { display:flex;align-items:center;min-height:91rpx;border-bottom:1rpx solid #f0f0ed; }.feature-row:last-child { border-bottom:0; }.feature-icon { width:47rpx;height:47rpx;border-radius:50%;background:#f3f4ef;display:flex;align-items:center;justify-content:center;font-size:22rpx;margin-right:16rpx; }.feature-text { flex:1;min-width:0; }.feature-title { display:block;font-size:19rpx;font-weight:600; }.feature-desc { display:block;font-size:17rpx;color:#6f706a;margin-top:5rpx; }.feature-arrow { color:#9c9c97;font-size:32rpx; }.source-note { font-size:17rpx;color:#6f706a;text-align:center;margin-top:18rpx; }
.bottom-actions { position:fixed;left:28rpx;right:28rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));height:94rpx;border-radius:50rpx;padding:9rpx;background:#fff;display:flex;gap:8rpx;box-shadow:0 8rpx 36rpx rgba(0,0,0,.08);z-index:10; }.compare-button,.ask-button { flex:1;border-radius:42rpx;display:flex;align-items:center;justify-content:center;font-size:19rpx;font-weight:600; }.compare-button { background:#f1f2ee; }.ask-button { background:#171717;color:#fff; }.ask-button text { font-size:25rpx;margin-left:10rpx; }

.source-note { overflow-wrap:anywhere;word-break:break-all;line-height:1.5; }
