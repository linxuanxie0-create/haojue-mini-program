.cover-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #dfe2e6;
  color: #111210;
}

.cover-motion {
  position: absolute;
  left: 91rpx;
  top: 341rpx;
  width: 660rpx;
  height: 880rpx;
  opacity: 0;
  transform: translate(360rpx, 16rpx) scale(.84);
  transform-origin: 76% 52%;
}

.ambient {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
}

.ambient-top {
  top: 0;
  height: 42%;
  background: linear-gradient(180deg, rgba(235, 238, 242, .9) 0%, rgba(235, 238, 242, .18) 62%, rgba(235, 238, 242, 0) 100%);
}

.ambient-bottom {
  bottom: 0;
  height: 52%;
  background: linear-gradient(180deg, rgba(14, 15, 14, 0) 0%, rgba(14, 15, 14, .7) 38%, rgba(14, 15, 14, .98) 100%);
}

.cover-header {
  position: absolute;
  left: 36rpx;
  display: flex;
  align-items: center;
  opacity: 0;
  transform: translateY(-14rpx);
  animation: contentIn .72s cubic-bezier(.16, 1, .3, 1) .5s forwards;
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #d7fb35;
  color: #111210;
  font-size: 23rpx;
  font-weight: 700;
}

.brand-wording {
  margin-left: 14rpx;
}

.brand-name {
  font-size: 22rpx;
  line-height: 1.1;
  font-weight: 650;
}

.brand-note {
  margin-top: 6rpx;
  color: rgba(17, 18, 16, .56);
  font-size: 13rpx;
  letter-spacing: 2rpx;
}

.model-panel {
  position: absolute;
  left: 36rpx;
  opacity: 0;
  transform: translateX(-24rpx);
  animation: contentIn .82s cubic-bezier(.16, 1, .3, 1) .84s forwards;
}

.model-series {
  color: rgba(17, 18, 16, .5);
  font-size: 21rpx;
  font-weight: 620;
  letter-spacing: 8rpx;
}

.model-number {
  margin-top: -9rpx;
  font-size: 110rpx;
  line-height: 1;
  font-weight: 720;
  letter-spacing: -5rpx;
}

.model-state {
  width: 136rpx;
  height: 40rpx;
  margin-top: 13rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .72);
  color: rgba(17, 18, 16, .64);
  font-size: 14rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.state-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #d7fb35;
}

.cover-content {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(env(safe-area-inset-bottom) + 26rpx);
  color: #fff;
}

.cover-title {
  max-width: 620rpx;
  font-size: 50rpx;
  line-height: 1.17;
  font-weight: 680;
  letter-spacing: -1.5rpx;
  opacity: 0;
  transform: translateY(24rpx);
  animation: contentIn .78s cubic-bezier(.16, 1, .3, 1) 1.1s forwards;
}

.cover-description {
  max-width: 590rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, .7);
  font-size: 21rpx;
  line-height: 1.55;
  opacity: 0;
  transform: translateY(18rpx);
  animation: contentIn .72s cubic-bezier(.16, 1, .3, 1) 1.25s forwards;
}

.entry-actions {
  margin-top: 30rpx;
  display: flex;
  opacity: 0;
  transform: translateY(28rpx);
  animation: contentIn .86s cubic-bezier(.16, 1, .3, 1) 1.48s forwards;
}

.entry-button {
  flex: 1;
  min-width: 0;
  min-height: 132rpx;
  padding: 0 26rpx;
  border-radius: 66rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  font-weight: 650;
  box-sizing: border-box;
}

.entry-primary {
  background: #d7fb35;
  color: #111210;
}

.entry-secondary {
  margin-left: 28rpx;
  background: rgba(255, 255, 255, .94);
  color: #111210;
}

.entry-arrow {
  margin-top: -3rpx;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 360;
}

@keyframes contentIn {
  0% { opacity: 0; }
  100% { opacity: 1; transform: translate(0, 0); }
}

.detail-entry { margin-top:24rpx;padding:20rpx 24rpx;border-radius:32rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;background:rgba(255,255,255,.16);color:rgba(255,255,255,.88);font-size:18rpx; }.detail-entry text { font-size:24rpx; }
